# sMove 05-espnow-imu / tx defaults — ESP32-C3-MINI-1-N4 (4 MB embedded flash).
CONFIG_IDF_TARGET="esp32c3"

# Native USB (U1 GPIO18/19 -> USB_DM_MCU/USB_DP_MCU). The board has no
# USB-UART bridge, so keep the log console on the USB Serial/JTAG peripheral.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# 4 MB flash, single app partition.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP=y

# ESP-NOW needs Wi-Fi; it does not need Bluetooth.
CONFIG_BT_ENABLED=n

# Boot / pair / 5 s link summary only — the samples travel over the radio, the
# console is just diagnostics.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 1 ms tick keeps the 100 ms sampling cadence tight.
CONFIG_FREERTOS_HZ=1000
