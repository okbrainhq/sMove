  (text "Protected pack J2\nU6 charger -> U4 LDO"
    (at 30.48 134.62 0)
    (effects
      (font
        (size 1.02 1.02))
      (justify left))
    (uuid 6cf65997-01a2-53b7-8d1e-b9028b682506))
  (text "ESP32-C3 / reset / boot / RGB\n\nJ4 -> separate IMU carrier PCB\nPH4: 1=3V3, 2=GND\n3=SDA, 4=SCL; <=50mm\n\nCarrier U2: direct on its root\nNo nested IMU sheets"
    (at 195.58 91.44 0)
    (effects
      (font
        (size 1.02 1.02))
      (justify left))
    (uuid 0c897977-9e0d-57bd-8539-d8ecf7fe43cc))
  (text "Prototype only. Supervised off-body charging; no TS cell-temperature sensing."
    (at 25.4 180.34 0)
    (effects
      (font
        (size 1.02 1.02))
      (justify left))
    (uuid eae55707-fff5-500b-8cc7-7dbf39fb82c4))
